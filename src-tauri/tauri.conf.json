{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Player",
  "version": "1.0.0",
  "identifier": "com.glassplayer.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glass Player",
        "width": 860,
        "height": 620,
        "minWidth": 360,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
